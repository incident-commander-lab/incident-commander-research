{
 "uid": "ic-shop",
 "title": "Shop and AI assistant",
 "timezone": "browser",
 "refresh": "10s",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "tags": [
  "incident-commander"
 ],
 "panels": [
  {
   "type": "row",
   "title": "What users see (measured at the ingress)",
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 0
   },
   "collapsed": false,
   "panels": [],
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "Requests per second",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "w": 8,
    "h": 8,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(traefik_service_requests_total{service=~\"shop-.*\"}[1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "Latency p95",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "w": 8,
    "h": 8,
    "x": 8,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket{service=~\"shop-.*\"}[1m])))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "Error rate (5xx)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "w": 8,
    "h": 8,
    "x": 16,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(traefik_service_requests_total{service=~\"shop-.*\",code=~\"5..\"}[1m])) / sum by (service) (rate(traefik_service_requests_total{service=~\"shop-.*\"}[1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "id": 4
  },
  {
   "type": "row",
   "title": "AI assistant (the GPU's workload)",
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 9
   },
   "collapsed": false,
   "panels": [],
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Answer time p95",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "w": 6,
    "h": 8,
    "x": 0,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(assistant_request_seconds_bucket[1m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Queue and in flight",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "w": 6,
    "h": 8,
    "x": 6,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "sum(assistant_queue_depth)",
     "legendFormat": "waiting",
     "refId": "A"
    },
    {
     "expr": "sum(assistant_inflight)",
     "legendFormat": "at the model",
     "refId": "B"
    }
   ],
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Tokens per second",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "w": 6,
    "h": 8,
    "x": 12,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(assistant_tokens_total[1m]))",
     "legendFormat": "tokens/s",
     "refId": "A"
    }
   ],
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "Answers by outcome",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "w": 6,
    "h": 8,
    "x": 18,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(assistant_requests_total[1m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "Memory kept by the assistant",
   "description": "Grows only under the memory-leak release",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "w": 8,
    "h": 8,
    "x": 0,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
