      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "expr": "sum(assistant_retained_bytes)",
     "legendFormat": "retained",
     "refId": "A"
    }
   ],
   "id": 10
  },
  {
   "type": "timeseries",
   "title": "Orders placed",
   "description": "",
   "datasource": {
    "type": "prometheus",
