    }
   },
   "targets": [
    {
     "expr": "sum(rate(juiceshop_orders_placed_total[5m])) * 60",
     "legendFormat": "orders/min",
     "refId": "A"
    }
   ],
   "id": 11
  },
  {
   "type": "timeseries",
   "title": "Running release",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "w": 8,
    "h": 8,
    "x": 16,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
