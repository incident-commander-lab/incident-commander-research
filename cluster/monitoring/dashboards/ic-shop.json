   },
   "gridPos": {
    "w": 8,
    "h": 8,
    "x": 8,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
