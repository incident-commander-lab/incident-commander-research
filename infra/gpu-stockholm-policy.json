{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GpuStacksInStockholm",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack", "cloudformation:UpdateStack", "cloudformation:DeleteStack",
        "cloudformation:DescribeStacks", "cloudformation:DescribeStackEvents", "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources", "cloudformation:GetTemplate", "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet", "cloudformation:ExecuteChangeSet", "cloudformation:DeleteChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:eu-north-1:ACCOUNT_ID:stack/ic-gpu*/*"
    },
    {
      "Sid": "AmiLookupInStockholm",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": [
        "arn:aws:ssm:eu-north-1::parameter/aws/service/canonical/*",
        "arn:aws:ssm:eu-north-1::parameter/aws/service/deeplearning/*"
      ]
    },
    {
      "Sid": "Ec2InStockholmOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances", "ec2:StartInstances", "ec2:StopInstances", "ec2:TerminateInstances",
        "ec2:CreateSecurityGroup", "ec2:DeleteSecurityGroup", "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress", "ec2:CreateTags", "ec2:CreateLaunchTemplate",
        "ec2:DeleteLaunchTemplate", "ec2:CreateLaunchTemplateVersion", "ec2:Describe*"
      ],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "eu-north-1"}}
    },
    {
      "Sid": "CostGuardOnlyPlannedInstanceTypes",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {"StringNotEquals": {"ec2:InstanceType": [
        "g4dn.xlarge", "g5.xlarge", "g6.xlarge", "c7i.xlarge", "m7i.xlarge", "t3.medium", "t3.large"]}}
    },
    {
      "Sid": "SpotServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/aws-service-role/spot.amazonaws.com/AWSServiceRoleForEC2Spot",
      "Condition": {"StringLike": {"iam:AWSServiceName": "spot.amazonaws.com"}}
    },
    {
      "Sid": "GpuStackRoleAndProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:TagRole", "iam:UntagRole",
        "iam:ListRolePolicies", "iam:ListAttachedRolePolicies", "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile", "iam:GetInstanceProfile", "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": ["arn:aws:iam::ACCOUNT_ID:role/ic-gpu*", "arn:aws:iam::ACCOUNT_ID:instance-profile/ic-gpu*"]
    },
    {
      "Sid": "OnlySsmPolicyOnGpuRole",
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/ic-gpu*",
      "Condition": {"ArnEquals": {"iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"}}
    },
    {
      "Sid": "PassGpuRoleToEc2Only",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/ic-gpu*",
      "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
    },
    {
      "Sid": "IdleStopAlarmInStockholm",
      "Effect": "Allow",
      "Action": ["cloudwatch:PutMetricAlarm", "cloudwatch:DeleteAlarms", "cloudwatch:DescribeAlarms"],
      "Resource": "arn:aws:cloudwatch:eu-north-1:ACCOUNT_ID:alarm:ic-gpu*"
    },
    {
      "Sid": "ShellIntoGpuHostsOnly",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:eu-north-1:ACCOUNT_ID:instance/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/project": "incident-commander-gpu"}}
    },
    {
      "Sid": "SessionDocumentsInStockholm",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ssm:eu-north-1::document/SSM-SessionManagerRunShell",
        "arn:aws:ssm:eu-north-1::document/AWS-StartSSHSession",
        "arn:aws:ssm:eu-north-1::document/AWS-StartNonInteractiveCommand",
        "arn:aws:ssm:eu-north-1::document/AWS-StartPortForwardingSession"
      ]
    },
    {
      "Sid": "ReadOnlyCostAndQuotaChecks",
      "Effect": "Allow",
      "Action": [
        "freetier:GetAccountPlanState", "freetier:ListAccountActivities", "freetier:GetFreeTierUsage",
        "pricing:GetProducts", "servicequotas:GetServiceQuota", "servicequotas:ListServiceQuotas"
      ],
      "Resource": "*"
    }
  ]
}
