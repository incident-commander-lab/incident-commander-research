{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SeeTheMachines",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus", "cloudformation:DescribeStacks", "ssm:DescribeSessions"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": ["us-east-1", "eu-north-1"]}}
    },
    {
      "Sid": "StartStopOnlyOurMachines",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances"],
      "Resource": "arn:aws:ec2:*:ACCOUNT_ID:instance/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/project": ["incident-commander-bench", "incident-commander-gpu"]}}
    },
    {
      "Sid": "ShellIntoOurMachinesOnly",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:*:ACCOUNT_ID:instance/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/project": ["incident-commander-bench", "incident-commander-gpu"]}}
    },
    {
      "Sid": "SessionDocuments",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ssm:*::document/SSM-SessionManagerRunShell",
        "arn:aws:ssm:*::document/AWS-StartSSHSession",
        "arn:aws:ssm:*::document/AWS-StartNonInteractiveCommand",
        "arn:aws:ssm:*::document/AWS-StartPortForwardingSession"
      ]
    },
    {
      "Sid": "EndOwnSessions",
      "Effect": "Allow",
      "Action": ["ssm:TerminateSession", "ssm:ResumeSession"],
      "Resource": "arn:aws:ssm:*:ACCOUNT_ID:session/${aws:username}-*"
    },
    {
      "Sid": "ReadCostsAndCredits",
      "Effect": "Allow",
      "Action": ["ce:GetCostAndUsage", "budgets:ViewBudget", "freetier:GetAccountPlanState"],
      "Resource": "*"
    },
    {
      "Sid": "ManageOwnPasswordAndMFA",
      "Effect": "Allow",
      "Action": ["iam:ChangePassword", "iam:GetUser", "iam:CreateVirtualMFADevice", "iam:EnableMFADevice",
                 "iam:ListMFADevices", "iam:ResyncMFADevice", "iam:GetLoginProfile"],
      "Resource": ["arn:aws:iam::ACCOUNT_ID:user/${aws:username}", "arn:aws:iam::ACCOUNT_ID:mfa/${aws:username}"]
    }
  ]
}
