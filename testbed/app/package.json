{
  "name": "pulse-testbed",
  "version": "0.1.0",
  "private": true,
  "description": "RQ3 live test bed: real public event streams -> Redis -> workers -> Postgres -> API, instrumented for Prometheus",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "collector": "node src/collector.js",
    "worker": "node src/worker.js",
    "api": "node src/api.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "4.21.2",
    "pg": "8.13.1",
    "prom-client": "15.1.3",
    "redis": "4.7.0"
  }
}
