{
 "title": "Pulse test bed",
 "uid": "pulse",
 "schemaVersion": 39,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Events/s in",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(pulse_events_received_total[1m]))"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Events/s stored",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(pulse_events_processed_total[1m]))"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Stream lag",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(pulse_stream_lag)"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Data age",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(pulse_source_last_event_timestamp_seconds)"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Events per second (real Wikipedia traffic)",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (rate(pulse_events_received_total[1m]))",
     "legendFormat": "in: {{kind}}"
    },
    {
     "refId": "B",
     "expr": "sum(rate(pulse_events_processed_total[1m]))",
     "legendFormat": "stored"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Worker lag and pending",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "pulse_stream_lag",
     "legendFormat": "lag"
    },
    {
     "refId": "B",
     "expr": "pulse_stream_pending",
     "legendFormat": "pending"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Batch write time p95",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(pulse_batch_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "API latency p95 and 5xx rate",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(pulse_http_request_seconds_bucket[5m])))",
     "legendFormat": "p95 latency"
    },
    {
     "refId": "B",
     "expr": "sum(rate(pulse_http_requests_total{status=~\"5..\"}[5m]))",
     "legendFormat": "5xx/s"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Redis memory",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "redis_memory_used_bytes",
     "legendFormat": "used"
    },
    {
     "refId": "B",
     "expr": "redis_memory_max_bytes",
     "legendFormat": "max"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Source connected / reconnects",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "pulse_source_connected",
     "legendFormat": "connected"
    },
    {
     "refId": "B",
     "expr": "increase(pulse_source_reconnects_total[10m])",
     "legendFormat": "reconnects (10m)"
    }
   ]
  }
 ]
}