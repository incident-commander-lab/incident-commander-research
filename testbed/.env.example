# Copy to .env (never commit .env). Everything has a working default.
USER_AGENT=pulse-testbed/0.1 (research test bed; contact: you@example.com)
# Agent autonomy: shadow (record only) | suggest (ask a human) | act (OPA-gated, verified, auto-revert)
AUTONOMY=shadow
# Local model via Ollama on your machine (install Ollama, then: ollama pull qwen3:8b)
AGENT_MODEL=qwen3:8b
# OLLAMA_URL=http://host.docker.internal:11434/v1
# Slack incoming webhook for escalations (optional; without it messages go to incidents/outbox.log)
SLACK_WEBHOOK_URL=
# Fault injector: serve (manual faults only) | schedule (random faults)
CHAOS_MODE=serve
CHAOS_MEAN_GAP_MIN=30
FAULT_TIMEOUT_MIN=20
VERIFY_SECONDS=120
# Host ports (change if something on your machine already uses them)
API_PORT=3300
GRAFANA_PORT=3301
PROM_PORT=9390
AM_PORT=9393
AGENT_PORT=8380
